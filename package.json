{
  "name": "freetour-praga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-platform next dev --webpack --port 3100",
    "build": "next build --webpack && node scripts/sanitize-build.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "prisma migrate deploy",
    "worker": "node scripts/worker.mjs",
    "postinstall": "prisma generate",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:http": "node scripts/run-http-tests.mjs",
    "test:http:production": "node scripts/run-production-http-tests.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/client": "^6.11.1",
    "date-fns": "^4.1.0",
    "ics": "^3.8.1",
    "imapflow": "^2.10.2",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.2",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "stripe": "^17.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "minimatch": "11.0.5"
  }
}
