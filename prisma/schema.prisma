generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TourStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  MODIFIED
  NO_SHOW
  PRESENT
}

enum PaymentMethod {
  CASH
  STRIPE
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SlotStatus {
  ACTIVE
  CLOSED
  SOLD_OUT
}

model Tour {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  category        String
  shortDescription String
  description     String
  imageUrl        String
  meetingPoint    String
  meetingAddress  String
  mapUrl          String
  durationMinutes Int
  basePriceCents  Int
  childPriceCents Int
  infantPriceCents Int
  maxGuests       Int
  language        String       @default("Italiano")
  status          TourStatus   @default(PUBLISHED)
  seoTitle        String
  seoDescription  String
  highlights      String[]
  inclusions      String[]
  safetyNotes     String[]
  slots           TourSlot[]
  bookings        Booking[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model TourSlot {
  id           String      @id @default(cuid())
  tourId       String
  tour         Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  reserved     Int         @default(0)
  status       SlotStatus  @default(ACTIVE)
  bookings     Booking[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tourId, startsAt])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  country   String    @default("IT")
  notes     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([phone])
}

model Booking {
  id                 String        @id @default(cuid())
  pnr                String        @unique
  tourId             String
  tour               Tour          @relation(fields: [tourId], references: [id])
  slotId             String
  slot               TourSlot      @relation(fields: [slotId], references: [id])
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  adults             Int
  children           Int           @default(0)
  infants            Int           @default(0)
  totalGuests        Int
  subtotalCents      Int
  discountCents      Int           @default(0)
  totalCents         Int
  currency           String        @default("EUR")
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  status             BookingStatus @default(PENDING)
  stripeSessionId    String?
  stripePaymentUrl   String?
  selfServiceToken   String?
  selfServiceExpires DateTime?
  source             String        @default("site")
  affiliateCode      String?
  calendarUid        String        @unique
  operationalNotes   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([slotId])
  @@index([tourId])
  @@index([status])
  @@index([paymentStatus])
  @@index([affiliateCode])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("operator")
  createdAt DateTime @default(now())
}

model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  status    String   @default("queued")
  sentAt    DateTime?
  error     String?
  createdAt DateTime @default(now())
}
